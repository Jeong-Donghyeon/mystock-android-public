<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 이하의 백업 규칙. allowBackup="false"가 이미 다 막지만 minSdk가 31 아래면 lint(DataExtractionRules)가 이 파일을 요구한다 -->
<full-backup-content>
    <exclude domain="sharedpref" path="auth.xml" />
    <exclude domain="sharedpref" path="device.xml" />
</full-backup-content>
